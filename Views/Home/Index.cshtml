@{ ViewData["Title"] = "Inicio"; }

<div class="container-xl">
    <section class="home-intro" aria-labelledby="home-title">
        <div>
            <span class="eyebrow">El catálogo de la biblioteca</span>
            <h1 id="home-title">Un lugar<br />para leer.</h1>
        </div>
        <div class="home-intro-copy">
            <p>Consulta los libros, su disponibilidad y los datos de sus autores.</p>
            <a class="text-link" asp-controller="Libros" asp-action="Index">Explorar el catálogo <span aria-hidden="true">↗</span></a>
        </div>
    </section>

    <section class="collection-directory" aria-labelledby="directory-title">
        <h2 class="directory-heading" id="directory-title">Explorar la colección</h2>
        <a class="directory-link" asp-controller="Libros" asp-action="Index">
            <h3>Libros</h3>
            <p>Obras, descripciones y disponibilidad.</p>
            <span aria-hidden="true">→</span>
        </a>
        <a class="directory-link" asp-controller="Autores" asp-action="Index">
            <h3>Autores</h3>
            <p>Fotografías y datos de los escritores.</p>
            <span aria-hidden="true">→</span>
        </a>
        <a class="directory-link" asp-controller="Categorias" asp-action="Index">
            <h3>Categorías</h3>
            <p>La colección organizada por temas.</p>
            <span aria-hidden="true">→</span>
        </a>
    </section>
</div>
