@model Categoria
@{ ViewData["Title"] = "Editar categoría"; }

<section class="module-page">
    <div class="container-xl">
        <div class="entity-form-shell">
            <a class="back-link" asp-action="Index">← Volver a categorías</a>
            <header class="entity-form-header">
                <h1>Editar categoría</h1>
                <p>Actualiza el nombre y la descripción de este tema.</p>
            </header>
            <form asp-action="Edit" asp-route-id="@Model.ID" method="post" class="entity-form-card">
                <input asp-for="ID" type="hidden" />
                <partial name="_Form" model="Model" />
                <div class="form-actions">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    <button class="btn btn-primary" type="submit">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
