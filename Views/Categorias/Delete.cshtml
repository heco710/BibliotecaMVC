@model Categoria
@{ ViewData["Title"] = "Eliminar categoría"; }

<section class="module-page">
    <div class="container-xl">
        <div class="entity-form-shell entity-form-shell-narrow">
            <a class="back-link" asp-action="Index">← Volver a categorías</a>
            <article class="danger-panel">
                <span class="danger-mark" aria-hidden="true">!</span>
                <span class="module-kicker">Confirmación requerida</span>
                <h1>Eliminar categoría</h1>
                <p>Vas a eliminar <strong>@Model.Nombre</strong> del listado de categorías.</p>
                <p class="category-description">@(Model.Descripcion ?? "Sin descripción")</p>
                <form asp-action="Delete" asp-route-id="@Model.ID" method="post" class="form-actions">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    <button class="btn btn-danger" type="submit">Sí, eliminar categoría</button>
                </form>
            </article>
        </div>
    </div>
</section>
