@model Categoria
@{ ViewData["Title"] = "Agregar categoría"; }

<section class="module-page">
    <div class="container-xl">
        <div class="entity-form-shell">
            <a class="back-link" asp-action="Index">← Volver a categorías</a>
            <header class="entity-form-header">
                <span class="module-kicker">Nuevo registro</span>
                <h1>Agregar categoría</h1>
                <p>Define un tema y, si lo deseas, una descripción para la colección.</p>
            </header>
            <form asp-action="Create" method="post" class="entity-form-card">
                <partial name="_Form" model="Model" />
                <div class="form-actions">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    <button class="btn btn-primary" type="submit">Guardar categoría</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
