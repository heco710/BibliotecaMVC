@if (User.Identity?.IsAuthenticated == true)
{
    var rol = Roles.Lista.FirstOrDefault(User.IsInRole) ?? "Sin rol";
    <li class="nav-item auth-nav"><span class="session-user" title="@User.Identity.Name · Rol: @rol">@User.Identity.Name<span class="visually-hidden">, rol @rol</span></span></li>
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link session-logout">Cerrar sesión</button>
        </form>
    </li>
}
else
{
    <li class="nav-item auth-nav"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Registrarse</a></li>
}
