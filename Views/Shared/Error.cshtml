@model ErrorViewModel
@{
    ViewData["Title"] = "Algo salió mal";
    // Página de UseExceptionHandler: mensaje general, sin trazas ni detalles internos de la excepción.
    var estado = new PaginaEstadoViewModel
    {
        Codigo = "500",
        Etiqueta = "Error inesperado",
        Titulo = "Algo salió mal al procesar tu solicitud",
        Mensaje = "Ocurrió un problema que no esperábamos. No es algo que hayas hecho mal: el incidente quedó registrado para revisarlo.",
        Detalle = "Puedes volver al inicio o continuar en otra sección. Si estabas guardando cambios, revisa el listado antes de intentarlo de nuevo.",
        Referencia = Model?.RequestId,
        Acciones =
        [
            new("Ir al inicio", Url.Action("Index", "Home")!, Principal: true),
            new("Ver categorías", Url.Action("Index", "Categorias")!)
        ]
    };
}
<partial name="_PaginaEstado" model="estado" />
