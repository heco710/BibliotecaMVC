@{ ViewData["Title"] = "Servicio no disponible"; }
<section class="module-page">
    <div class="container-xl">
        <div class="entity-form-shell">
            <div class="alert alert-danger" role="alert">
                <h1 class="h3">No se pudo completar la operación</h1>
                <p>El servicio de categorías no está disponible en este momento. Si estabas guardando cambios, comprueba el listado antes de volver a intentarlo.</p>
                <a class="btn btn-outline-danger" asp-controller="Categorias" asp-action="Index">Volver a categorías</a>
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Ir al inicio</a>
            </div>
        </div>
    </div>
</section>
