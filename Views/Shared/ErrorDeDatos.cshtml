@{
    ViewData["Title"] = "Servicio no disponible";
    var enCuenta = ViewContext.RouteData.Values["controller"]?.ToString() == "Account";
    var estado = new PaginaEstadoViewModel
    {
        Codigo = "503",
        Etiqueta = "Servicio no disponible",
        Titulo = "No se pudo completar la operación",
        Mensaje = "No se pudo acceder a los datos en este momento. Si estabas guardando cambios, comprueba el listado antes de volver a intentarlo.",
        Icono = "datos",
        Tono = "aviso",
        Acciones =
        [
            enCuenta
                ? new AccionEstado("Volver al inicio de sesión", Url.Action("Login", "Account")!, Principal: true)
                : new AccionEstado("Volver al listado", Url.Action("Index")!, Principal: true),
            new("Ir al inicio", Url.Action("Index", "Home")!)
        ]
    };
}
<partial name="_PaginaEstado" model="estado" />
