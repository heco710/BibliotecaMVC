@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Libros";
}

<main class="module-page catalog-page">
    <div class="container-xl">
        <header class="module-header">
            <div>
                <span class="module-kicker">Biblioteca virtual</span>
                <h1>Catálogo de libros</h1>
                <p>Explora la colección y administra la información de cada obra.</p>
            </div>
            <a class="btn btn-primary" asp-action="Create">Agregar libro</a>
        </header>

        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <section class="catalog-book-grid" aria-label="Libros registrados">
            @foreach (var libro in Model)
            {
                <article class="catalog-book-card">
                    <a class="catalog-book-image-link" asp-action="Details" asp-route-id="@libro.ID">
                        <img class="catalog-book-image" src="@Url.Content($"~/images/{libro.Imagen}")" alt="Ilustración representativa de @libro.Titulo" />
                    </a>
                    <div class="catalog-book-body">
                        <div class="catalog-book-meta">
                            <span class="category-pill">@libro.Categoria</span>
                            <span class="status-badge @(libro.Disponible ? "status-active" : "status-inactive")">
                                @(libro.Disponible ? "Disponible" : "Prestado")
                            </span>
                        </div>
                        <h2>@libro.Titulo</h2>
                        <p class="catalog-book-author">@libro.Autor</p>
                        <p class="catalog-book-description">@libro.Descripcion</p>
                        <div class="catalog-book-footer">
                            <span>@libro.AnioPublicacion</span>
                            <div class="action-group">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@libro.ID">Ver</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@libro.ID">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@libro.ID">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </section>
    </div>
</main>
