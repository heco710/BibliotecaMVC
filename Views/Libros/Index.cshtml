@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Libros";
}

<section class="module-page catalog-page">
    <div class="container-xl">
        <header class="module-header">
            <div>
                <h1>Libros</h1>
                <p>@Model.Count() libros en el catálogo.</p>
            </div>
            <a class="btn btn-primary" asp-action="Create">Agregar libro</a>
        </header>

        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info" role="status">Todavía no hay libros registrados. Usa «Agregar libro» para comenzar.</div>
        }

        <section class="catalog-book-grid" aria-label="Libros registrados">
            @foreach (var libro in Model)
            {
                <article class="catalog-book-card">
                    <a class="catalog-book-image-link" asp-action="Details" asp-route-id="@libro.ID">
                        <img class="catalog-book-image" src="@Url.Content($"~/images/{libro.Imagen}")" alt="Portada de @libro.Titulo" asp-append-version="true" loading="lazy" />
                    </a>
                    <div class="catalog-book-body">
                        <div class="catalog-book-meta">
                            <span class="category-pill">@libro.Categoria</span>
                        </div>
                        <h2><a asp-action="Details" asp-route-id="@libro.ID">@libro.Titulo</a></h2>
                        <p class="catalog-book-author">@libro.Autor</p>
                        <p class="book-availability">Estado: @(libro.Disponible ? "Disponible" : "Prestado")</p>
                        <p class="catalog-book-description">@libro.Descripcion</p>
                        <div class="catalog-book-footer">
                            <span>@libro.AnioPublicacion</span>
                            <div class="action-group">
                                <a class="row-action" asp-action="Edit" asp-route-id="@libro.ID">Editar</a>
                                <a class="row-action row-action-danger" asp-action="Delete" asp-route-id="@libro.ID">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </section>
    </div>
</section>
