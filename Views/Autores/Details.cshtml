@model Autor

@{
    ViewData["Title"] = "Detalle del autor";
}

<main class="module-page">
    <div class="container-xl">
        <div class="entity-form-shell">
            <a class="back-link" asp-action="Index">← Volver a autores</a>
            <article class="detail-card">
                <div class="detail-card-top">
                    <span class="entity-avatar entity-avatar-large" aria-hidden="true">@Model.Nombre[0]@Model.Apellido[0]</span>
                    <div>
                        <span class="module-kicker">Autor #@Model.ID</span>
                        <h1>@Model.Nombre @Model.Apellido</h1>
                        <span class="status-badge @(Model.Activo ? "status-active" : "status-inactive")">
                            @(Model.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>
                <dl class="detail-list">
                    <div><dt>Nacionalidad</dt><dd>@Model.Nacionalidad</dd></div>
                    <div><dt>Fecha de nacimiento</dt><dd>@Model.FechaNacimiento.ToString("dd 'de' MMMM 'de' yyyy")</dd></div>
                </dl>
                <div class="form-actions">
                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.ID">Eliminar</a>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ID">Editar autor</a>
                </div>
            </article>
        </div>
    </div>
</main>
