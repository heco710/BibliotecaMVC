@model List<Autor>

@{
    ViewData["Title"] = "Autores";
}

<h1>Catálogo de Autores</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Nacionalidad</th>
                <th>Fecha de nacimiento</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var autor in Model)
            {
                <tr>
                    <td>@autor.ID</td>
                    <td>@autor.Nombre</td>
                    <td>@autor.Apellido</td>
                    <td>@autor.Nacionalidad</td>
                    <td>@autor.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (autor.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
