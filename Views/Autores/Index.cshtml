@model IEnumerable<Autor>
@{ ViewData["Title"] = "Autores"; }

<section class="module-page">
    <div class="container-xl">
        <header class="module-header">
            <div>
                <h1 id="authors-title">Autores</h1>
                <p>@Model.Count() autores en el catálogo.</p>
            </div>
            <a class="btn btn-primary" asp-action="Create">Agregar autor</a>
        </header>
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        <section class="author-directory" aria-labelledby="authors-title">
            @if (!Model.Any())
            {
                <p class="py-4">Todavía no hay autores registrados. Usa «Agregar autor» para comenzar.</p>
            }
            @foreach (var autor in Model)
            {
                <article class="author-row">
                    <partial name="_Retrato" model="autor" />
                    <div class="author-info">
                        <h2><a asp-action="Details" asp-route-id="@autor.ID">@autor.Nombre @autor.Apellido</a></h2>
                        <p>@autor.Nacionalidad <span aria-hidden="true">·</span> Nació el @autor.FechaNacimiento.ToString("dd/MM/yyyy")</p>
                        <p class="author-status">@(autor.Activo ? "Activo en el catálogo" : "Inactivo en el catálogo")</p>
                    </div>
                    <div class="action-group">
                        <a class="row-action" asp-action="Edit" asp-route-id="@autor.ID" aria-label="Editar a @autor.Nombre @autor.Apellido">Editar</a>
                        <a class="row-action row-action-danger" asp-action="Delete" asp-route-id="@autor.ID" aria-label="Eliminar a @autor.Nombre @autor.Apellido">Eliminar</a>
                    </div>
                </article>
            }
        </section>
    </div>
</section>
